# Alamat API yang dipanggil browser.
# Pengembangan: /api (diteruskan Vite ke DEV_API_TARGET).
# Produksi (Vercel): alamat BE publik berakhiran /api, misalnya https://be-aura.example.com/api
VITE_API_BASE_URL=/api

# Tujuan proxy saat pengembangan: server tiruan atau BE asli.
#   http://localhost:4010  -> server tiruan (npm run mock)
#   http://localhost:3000  -> BE asli yang berjalan lokal
DEV_API_TARGET=http://localhost:4010

# Kata sandi akun demo (staf, verif, admin). Samakan dengan DEMO_PASSWORD di BE.
# Data demo bersifat sintetis. Jangan pakai kata sandi yang sama dengan akun pribadi.
VITE_DEMO_PASSWORD=