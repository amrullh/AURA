# Salin menjadi .env lalu isi. JANGAN commit .env.
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoice_agent
# true = tabel dibuat/diperbarui otomatis saat start (cukup untuk lomba). Set false bila memakai migrasi.
DB_SYNC=true
AUTO_SEED=true

JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN_SEC=28800
# Kata sandi akun demo (staf@demo.id, verif@demo.id, admin@demo.id). Ganti sebelum deploy publik.
DEMO_PASSWORD=demo12345

UPLOAD_DIR=./storage
MAX_FILES_PER_BATCH=50
MAX_FILE_SIZE_MB=10
PROCESSING_CONCURRENCY=3

# stub = agent tiruan (hasil contoh); http = agent sungguhan di AGENT_URL
AGENT_MODE=stub
AGENT_URL=http://localhost:8000
AGENT_TIMEOUT_MS=120000
STUB_DELAY_MS=4000

# Lokasi kontrak untuk Swagger UI di /docs (relatif terhadap folder backend)
OPENAPI_PATH=../docs/api/openapi.yaml

# Origin FE yang diizinkan (dipisah koma). Kosongkan untuk mengizinkan semua.
# Contoh: CORS_ORIGINS=http://localhost:5173,https://aura-fe.vercel.app
CORS_ORIGINS=
